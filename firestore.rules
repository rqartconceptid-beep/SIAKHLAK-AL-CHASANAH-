rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null && (
        request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider == 'password'
      );
    }

    function isBootstrappedAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'rqartconcept.id@gmail.com';
    }

    function userDocPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function permDocPath(uid) {
      return /databases/$(database)/documents/user_permissions/$(uid);
    }

    function userExists() {
      return exists(userDocPath(request.auth.uid));
    }

    function userData() {
      return get(userDocPath(request.auth.uid)).data;
    }

    function isActiveUser() {
      return isSignedIn()
        && userExists()
        && (!('account_status' in userData()) || userData().account_status in ['ACTIVE', 'active'])
        && (!('organization_id' in userData()) || userData().organization_id == 'yayasan_siakhlak');
    }

    function isPendingUser() {
      return isSignedIn()
        && userExists()
        && ('account_status' in userData())
        && userData().account_status == 'PENDING'
        && (!('organization_id' in userData()) || userData().organization_id == 'yayasan_siakhlak');
    }

    function hasRole(r) {
      return (('roles' in userData()) && (r in userData().roles))
        || (('role' in userData()) && userData().role == r);
    }

    function hasPermission(perm) {
      return exists(permDocPath(request.auth.uid))
        && (perm in get(permDocPath(request.auth.uid)).data.permissions);
    }

    function isFoundationAdmin() {
      return isSignedIn() && (
        (!userExists() && isBootstrappedAdmin()) ||
        (isActiveUser() && (hasRole('FOUNDATION_ADMIN') || hasRole('yayasan')))
      );
    }

    function isCommitteeAdmin() {
      return isActiveUser() && (hasRole('COMMITTEE_ADMIN') || hasRole('komite_pendidikan_agama'));
    }

    function isTeacher() {
      return isActiveUser() && (hasRole('TEACHER') || hasRole('HOMEROOM_TEACHER') || hasRole('guru'));
    }

    function isStudent() {
      return isActiveUser() && (hasRole('STUDENT') || hasRole('siswa'));
    }

    function isParent() {
      return isActiveUser() && (hasRole('PARENT') || hasRole('orang_tua'));
    }

    function isActiveStaff() {
      return isFoundationAdmin() || isCommitteeAdmin() || isTeacher();
    }

    function hasKomiteStudentAccess() {
      return isCommitteeAdmin() && (
        (userExists() && userData().allowIndividualStudentAccess == true) ||
        hasPermission('committee:view_individual_students')
      );
    }

    function isUnitAuthorizedForKomite(unitCode) {
      return !isCommitteeAdmin() || (
        userExists() && (
          unitCode in userData().assignedUnits
          || unitCode == 'Seluruh Unit'
          || (unitCode == 'KB/TK' && ('TK' in userData().assignedUnits || 'KB/TK' in userData().assignedUnits))
          || (unitCode == 'SD/SDI' && ('SD' in userData().assignedUnits || 'SD/SDI' in userData().assignedUnits))
          || (unitCode == 'TK' && ('TK' in userData().assignedUnits || 'KB/TK' in userData().assignedUnits))
          || (unitCode == 'SD' && ('SD' in userData().assignedUnits || 'SD/SDI' in userData().assignedUnits))
        )
      );
    }

    function isGuruAuthorizedForUnitAndClass(unitCode, classId) {
      return isTeacher()
        && userExists()
        && (
          unitCode in userData().assignedUnits
          || (unitCode == 'KB/TK' && ('TK' in userData().assignedUnits || 'KB/TK' in userData().assignedUnits))
          || (unitCode == 'SD/SDI' && ('SD' in userData().assignedUnits || 'SD/SDI' in userData().assignedUnits))
          || (unitCode == 'TK' && ('TK' in userData().assignedUnits || 'KB/TK' in userData().assignedUnits))
          || (unitCode == 'SD' && ('SD' in userData().assignedUnits || 'SD/SDI' in userData().assignedUnits))
        )
        && ('assignedClassIds' in userData())
        && userData().assignedClassIds.size() > 0
        && (classId in userData().assignedClassIds);
    }

    function isClassAuthorizedForTeacher(classId) {
      return isTeacher()
        && userExists()
        && ('assignedClassIds' in userData())
        && userData().assignedClassIds.size() > 0
        && (classId in userData().assignedClassIds);
    }

    function isUnitAuthorizedForTeacher(unitCode) {
      return isTeacher()
        && userExists()
        && (
          unitCode in userData().assignedUnits
          || (unitCode == 'KB/TK' && ('TK' in userData().assignedUnits || 'KB/TK' in userData().assignedUnits))
          || (unitCode == 'SD/SDI' && ('SD' in userData().assignedUnits || 'SD/SDI' in userData().assignedUnits))
          || (unitCode == 'TK' && ('TK' in userData().assignedUnits || 'KB/TK' in userData().assignedUnits))
          || (unitCode == 'SD' && ('SD' in userData().assignedUnits || 'SD/SDI' in userData().assignedUnits))
        );
    }

    function isVerifiedAssessmentChangeAllowed() {
      return existing().verificationStatus != 'Terverifikasi'
        || incoming().diff(existing()).affectedKeys().hasOnly(['isPublishedToParents', 'updatedAt'])
        || ('revisionReason' in incoming() && incoming().revisionReason is string && incoming().revisionReason.size() >= 5);
    }

    function isLinkedToStudent(studentId) {
      return userExists() && ('linkedStudentIds' in userData()) && (studentId in userData().linkedStudentIds);
    }

    function isValidUnitCode(code) {
      return code in ['TK', 'SD', 'SMP', 'SMA', 'SMK', 'KB/TK', 'SD/SDI'];
    }

    function isValidUnitScope(code) {
      return code in ['TK', 'SD', 'SMP', 'SMA', 'SMK', 'KB/TK', 'SD/SDI', 'Seluruh Unit'];
    }

    function isValidRoleValue(r) {
      return r in [
        'STUDENT', 'PARENT', 'TEACHER', 'HOMEROOM_TEACHER', 'COMMITTEE_ADMIN', 'FOUNDATION_ADMIN',
        'yayasan', 'komite_pendidikan_agama', 'guru', 'siswa', 'orang_tua'
      ];
    }

    function isValidLifecycleStatus(s) {
      return s in ['PENDING', 'ACTIVE', 'INACTIVE', 'ARCHIVED', 'active', 'inactive', 'suspended'];
    }

    function isValidProfileStatus(s) {
      return s in ['PENDING', 'VERIFIED', 'REJECTED'];
    }

    // --- Validation Helpers ---
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'assignedUnits', 'allowIndividualStudentAccess'])
        && data.keys().hasOnly([
          'uid', 'email', 'full_name', 'displayName', 'phone', 'profile_photo',
          'roles', 'role', 'account_status', 'profile_status', 'requested_portal', 'requested_role',
          'organization_id', 'assignedUnits', 'assignedClassIds', 'linkedStudentIds',
          'allowIndividualStudentAccess', 'created_at', 'updated_at', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && (!('full_name' in data) || (data.full_name is string && data.full_name.size() >= 1 && data.full_name.size() <= 120))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('profile_photo' in data) || (data.profile_photo is string && data.profile_photo.size() <= 500))
        && (!('role' in data) || isValidRoleValue(data.role))
        && (!('roles' in data) || (data.roles is list && data.roles.size() >= 1 && data.roles.size() <= 6 && isValidRoleValue(data.roles[0])))
        && (!('account_status' in data) || isValidLifecycleStatus(data.account_status))
        && (!('profile_status' in data) || isValidProfileStatus(data.profile_status))
        && (!('requested_portal' in data) || data.requested_portal in ['parent_student', 'teacher', 'committee', 'foundation'])
        && (!('requested_role' in data) || isValidRoleValue(data.requested_role))
        && (!('organization_id' in data) || (data.organization_id is string && data.organization_id.size() >= 1 && data.organization_id.size() <= 80))
        && data.assignedUnits is list && data.assignedUnits.size() <= 5
        && (data.assignedUnits.size() == 0 || isValidUnitCode(data.assignedUnits[0]))
        && (!('assignedClassIds' in data) || (data.assignedClassIds is list && data.assignedClassIds.size() <= 20 && (data.assignedClassIds.size() == 0 || data.assignedClassIds[0] is string)))
        && (!('linkedStudentIds' in data) || (data.linkedStudentIds is list && data.linkedStudentIds.size() <= 10 && (data.linkedStudentIds.size() == 0 || data.linkedStudentIds[0] is string)))
        && data.allowIndividualStudentAccess is bool
        && (!('created_at' in data) || data.created_at is timestamp)
        && (!('updated_at' in data) || data.updated_at is timestamp)
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidUserPermissions(data, userId) {
      return data.keys().hasAll(['uid', 'organization_id', 'permissions', 'assigned_units', 'assigned_classes', 'updated_by', 'updated_at'])
        && data.keys().hasOnly(['uid', 'organization_id', 'permissions', 'assigned_units', 'assigned_classes', 'updated_by', 'updated_at'])
        && data.uid is string && data.uid == userId && data.uid.size() <= 128
        && data.organization_id is string && data.organization_id == 'yayasan_siakhlak'
        && data.permissions is list && data.permissions.size() <= 40
        && (data.permissions.size() == 0 || data.permissions[0] is string)
        && data.assigned_units is list && data.assigned_units.size() <= 5
        && (data.assigned_units.size() == 0 || isValidUnitCode(data.assigned_units[0]))
        && data.assigned_classes is list && data.assigned_classes.size() <= 20
        && (data.assigned_classes.size() == 0 || data.assigned_classes[0] is string)
        && data.updated_by is string && data.updated_by.size() <= 128
        && data.updated_at is timestamp;
    }

    function isValidStudentGuardian(data) {
      return data.keys().hasAll(['student_id', 'guardian_uid', 'relationship_type', 'verification_status', 'organization_id', 'created_by', 'created_at', 'updated_at'])
        && data.keys().hasOnly(['student_id', 'guardian_uid', 'guardian_id', 'relationship_type', 'verification_status', 'organization_id', 'created_by', 'created_at', 'updated_at'])
        && data.student_id is string && data.student_id.size() >= 1 && data.student_id.size() <= 128
        && data.guardian_uid is string && data.guardian_uid.size() >= 1 && data.guardian_uid.size() <= 128
        && (!('guardian_id' in data) || (data.guardian_id is string && data.guardian_id.size() <= 128))
        && data.relationship_type in ['ayah', 'ibu', 'wali', 'siswa']
        && data.verification_status in ['verified', 'pending', 'rejected']
        && data.organization_id == 'yayasan_siakhlak'
        && data.created_by is string && data.created_by.size() <= 128
        && data.created_at is timestamp
        && data.updated_at is timestamp;
    }

    function isValidClassAssignment(data) {
      return data.keys().hasAll(['teacher_uid', 'class_id', 'education_unit_id', 'academic_year_id', 'assignment_status', 'organization_id', 'created_by', 'created_at', 'updated_at'])
        && data.keys().hasOnly([
          'teacher_uid', 'teacher_id', 'class_id', 'education_unit_id', 'academic_year_id',
          'semester_id', 'assignment_status', 'is_homeroom', 'subject_name',
          'organization_id', 'created_by', 'created_at', 'updated_at'
        ])
        && data.teacher_uid is string && data.teacher_uid.size() >= 1 && data.teacher_uid.size() <= 128
        && (!('teacher_id' in data) || (data.teacher_id is string && data.teacher_id.size() <= 128))
        && data.class_id is string && data.class_id.size() >= 1 && data.class_id.size() <= 128
        && isValidUnitCode(data.education_unit_id)
        && data.academic_year_id is string && data.academic_year_id.size() >= 1 && data.academic_year_id.size() <= 128
        && (!('semester_id' in data) || (data.semester_id is string && data.semester_id.size() <= 128))
        && data.assignment_status in ['active', 'inactive', 'archived']
        && (!('is_homeroom' in data) || data.is_homeroom is bool)
        && (!('subject_name' in data) || (data.subject_name is string && data.subject_name.size() <= 100))
        && data.organization_id == 'yayasan_siakhlak'
        && data.created_by is string && data.created_by.size() <= 128
        && data.created_at is timestamp
        && data.updated_at is timestamp;
    }

    function isValidSystemConfig(data) {
      return data.keys().hasAll(['foundationName', 'activePeriodId', 'activePeriodName', 'komiteDefaultScope', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['foundationName', 'activePeriodId', 'activePeriodName', 'komiteDefaultScope', 'updatedBy', 'updatedAt'])
        && data.foundationName is string && data.foundationName.size() >= 1 && data.foundationName.size() <= 150
        && data.activePeriodId is string && data.activePeriodId.size() <= 128
        && data.activePeriodName is string && data.activePeriodName.size() <= 100
        && data.komiteDefaultScope is string && data.komiteDefaultScope.size() <= 200
        && data.updatedBy is string && data.updatedBy == request.auth.uid && data.updatedBy.size() <= 128
        && data.updatedAt is timestamp;
    }

    function isValidUnit(data) {
      return data.keys().hasAll(['code', 'name', 'headName', 'studentCount', 'teacherCount', 'classCount', 'updatedAt'])
        && data.keys().hasOnly([
          'code', 'education_level', 'name', 'headName', 'address', 'phone',
          'studentCount', 'teacherCount', 'classCount', 'religiousProgramNote', 'status', 'updatedAt'
        ])
        && isValidUnitCode(data.code)
        && (!('education_level' in data) || isValidUnitCode(data.education_level))
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.headName is string && data.headName.size() <= 120
        && (!('address' in data) || (data.address is string && data.address.size() <= 300))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && data.studentCount is number && data.studentCount >= 0
        && data.teacherCount is number && data.teacherCount >= 0
        && data.classCount is number && data.classCount >= 0
        && (!('religiousProgramNote' in data) || (data.religiousProgramNote is string && data.religiousProgramNote.size() <= 1000))
        && (!('status' in data) || isValidLifecycleStatus(data.status))
        && data.updatedAt is timestamp;
    }

    function isValidCohort(data) {
      return data.keys().hasAll(['cohortName', 'educationUnitId', 'educationLevel', 'admissionYear', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['cohortName', 'educationUnitId', 'educationLevel', 'admissionYear', 'graduationYear', 'status', 'notes', 'createdAt', 'updatedAt'])
        && data.cohortName is string && data.cohortName.size() >= 1 && data.cohortName.size() <= 100
        && data.educationUnitId is string && data.educationUnitId.size() >= 1 && data.educationUnitId.size() <= 128
        && isValidUnitCode(data.educationLevel)
        && data.admissionYear is string && data.admissionYear.size() >= 1 && data.admissionYear.size() <= 15
        && (!('graduationYear' in data) || (data.graduationYear is string && data.graduationYear.size() <= 15))
        && data.status in ['ACTIVE', 'INACTIVE', 'ARCHIVED']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAcademicYear(data) {
      return data.keys().hasAll(['yearName', 'isActive', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['yearName', 'startDate', 'endDate', 'isActive', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.yearName is string && data.yearName.size() >= 1 && data.yearName.size() <= 40
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 20))
        && (!('endDate' in data) || (data.endDate is string && data.endDate.size() <= 20))
        && data.isActive is bool
        && data.status in ['ACTIVE', 'INACTIVE', 'ARCHIVED']
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSemester(data) {
      return data.keys().hasAll(['academicYearId', 'yearName', 'semester', 'name', 'isActive', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['academicYearId', 'yearName', 'semester', 'name', 'isActive', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.academicYearId is string && data.academicYearId.size() >= 1 && data.academicYearId.size() <= 128
        && data.yearName is string && data.yearName.size() >= 1 && data.yearName.size() <= 40
        && data.semester in ['Ganjil', 'Genap']
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.isActive is bool
        && data.status in ['ACTIVE', 'INACTIVE', 'ARCHIVED']
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPeriod(data) {
      return data.keys().hasAll(['name', 'year', 'semester', 'isActive', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'year', 'semester', 'academicYearId', 'isActive', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && data.year is string && data.year.size() >= 1 && data.year.size() <= 30
        && data.semester in ['Ganjil', 'Genap']
        && (!('academicYearId' in data) || (data.academicYearId is string && data.academicYearId.size() <= 128))
        && data.isActive is bool
        && (!('status' in data) || isValidLifecycleStatus(data.status))
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClass(data) {
      return data.keys().hasAll(['unitCode', 'name', 'level', 'homeroomTeacherName', 'studentCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'unitCode', 'educationLevel', 'educationUnitId', 'educationUnitName', 'name', 'className', 'level',
          'cohortId', 'cohortName', 'academicYearId', 'semesterId', 'homeroomTeacherUid',
          'homeroomTeacherName', 'studentCount', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidUnitCode(data.unitCode)
        && (!('educationLevel' in data) || isValidUnitCode(data.educationLevel))
        && (!('educationUnitId' in data) || (data.educationUnitId is string && data.educationUnitId.size() <= 128))
        && (!('educationUnitName' in data) || (data.educationUnitName is string && data.educationUnitName.size() <= 120))
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && (!('className' in data) || (data.className is string && data.className.size() <= 80))
        && data.level is string && data.level.size() >= 1 && data.level.size() <= 40
        && (!('cohortId' in data) || (data.cohortId is string && data.cohortId.size() <= 128))
        && (!('cohortName' in data) || (data.cohortName is string && data.cohortName.size() <= 100))
        && (!('academicYearId' in data) || (data.academicYearId is string && data.academicYearId.size() <= 128))
        && (!('semesterId' in data) || (data.semesterId is string && data.semesterId.size() <= 128))
        && (!('homeroomTeacherUid' in data) || (data.homeroomTeacherUid is string && data.homeroomTeacherUid.size() <= 128))
        && data.homeroomTeacherName is string && data.homeroomTeacherName.size() <= 120
        && data.studentCount is number && data.studentCount >= 0
        && (!('status' in data) || data.status in ['ACTIVE', 'INACTIVE', 'ARCHIVED'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClassStudentHistory(data) {
      return data.keys().hasAll([
          'studentId', 'nis', 'studentName', 'educationLevel', 'educationUnitId',
          'cohortId', 'academicYearId', 'semesterId', 'toClassId', 'toClassName',
          'movementType', 'movedByUid', 'movedByName', 'createdAt'
        ])
        && data.keys().hasOnly([
          'studentId', 'studentUid', 'nis', 'studentName', 'educationLevel', 'educationUnitId',
          'cohortId', 'academicYearId', 'semesterId', 'fromClassId', 'fromClassName',
          'toClassId', 'toClassName', 'movementType', 'notes', 'movedByUid', 'movedByName', 'createdAt'
        ])
        && data.studentId is string && data.studentId.size() >= 1 && data.studentId.size() <= 128
        && (!('studentUid' in data) || (data.studentUid is string && data.studentUid.size() <= 128))
        && data.nis is string && data.nis.size() >= 1 && data.nis.size() <= 50
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 120
        && isValidUnitCode(data.educationLevel)
        && data.educationUnitId is string && data.educationUnitId.size() <= 128
        && data.cohortId is string && data.cohortId.size() <= 128
        && data.academicYearId is string && data.academicYearId.size() <= 128
        && data.semesterId is string && data.semesterId.size() <= 128
        && (!('fromClassId' in data) || (data.fromClassId is string && data.fromClassId.size() <= 128))
        && (!('fromClassName' in data) || (data.fromClassName is string && data.fromClassName.size() <= 80))
        && data.toClassId is string && data.toClassId.size() >= 1 && data.toClassId.size() <= 128
        && data.toClassName is string && data.toClassName.size() >= 1 && data.toClassName.size() <= 80
        && data.movementType in ['ENROLLMENT', 'PROMOTION', 'TRANSFER']
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 400))
        && data.movedByUid is string && data.movedByUid == request.auth.uid && data.movedByUid.size() <= 128
        && data.movedByName is string && data.movedByName.size() <= 120
        && data.createdAt is timestamp;
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['nip', 'name', 'unitCode', 'roleTitle', 'isPaiTeacher', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'teacher_id', 'user_uid', 'nip', 'employee_number', 'name', 'full_name',
          'email', 'phone', 'address', 'birth_place', 'birth_date', 'gender',
          'unitCode', 'education_level', 'education_unit_id', 'roleTitle', 'position',
          'employment_status', 'employment_start_date', 'teaching_subjects',
          'assigned_class_ids', 'academic_year_assignments', 'isPaiTeacher',
          'profile_photo', 'profile_status', 'status', 'createdAt', 'updatedAt'
        ])
        && data.nip is string && data.nip.size() >= 1 && data.nip.size() <= 50
        && (!('employee_number' in data) || (data.employee_number is string && data.employee_number.size() <= 50))
        && (!('user_uid' in data) || (data.user_uid is string && data.user_uid.size() <= 128))
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && (!('full_name' in data) || (data.full_name is string && data.full_name.size() <= 120))
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('address' in data) || (data.address is string && data.address.size() <= 400))
        && (!('birth_place' in data) || (data.birth_place is string && data.birth_place.size() <= 80))
        && (!('birth_date' in data) || (data.birth_date is string && data.birth_date.size() <= 20))
        && (!('gender' in data) || data.gender in ['L', 'P'])
        && isValidUnitCode(data.unitCode)
        && (!('education_level' in data) || isValidUnitCode(data.education_level))
        && (!('education_unit_id' in data) || (data.education_unit_id is string && data.education_unit_id.size() <= 128))
