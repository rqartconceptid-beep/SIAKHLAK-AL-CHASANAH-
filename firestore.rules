        && data.completedFollowUpsCount is number && data.completedFollowUpsCount >= 0
        && data.decisionsCount is number && data.decisionsCount >= 0
        && data.createdBy is string && data.createdBy.size() <= 128
        && data.createdByName is string && data.createdByName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Match Rules ---

    // 1. Users (Anti-Privilege Escalation, PENDING Lifecycle & PII Protection)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isFoundationAdmin() || isBootstrappedAdmin());
      allow list: if isFoundationAdmin() || isBootstrappedAdmin();
      allow create: if isSignedIn() && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && request.auth.uid == userId
        && (
          isBootstrappedAdmin()
          || (
            request.auth.token.email_verified == true
            && (!('role' in incoming()) || incoming().role in ['STUDENT', 'siswa'])
            && (!('roles' in incoming()) || (incoming().roles.size() == 1 && incoming().roles[0] in ['STUDENT', 'siswa']))
            && ('account_status' in incoming() && incoming().account_status == 'PENDING')
            && (!('organization_id' in incoming()) || incoming().organization_id == 'yayasan_siakhlak')
            && incoming().assignedUnits.size() == 0
            && incoming().allowIndividualStudentAccess == false
          )
        );
      allow update: if isSignedIn() && isValidId(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && (
          (isFoundationAdmin() || isBootstrappedAdmin())
          || (
            isActiveUser()
            && request.auth.uid == userId
            && incoming().diff(existing()).affectedKeys().hasOnly(['full_name', 'displayName', 'phone', 'profile_photo', 'updated_at', 'updatedAt'])
          )
          || (
            isPendingUser()
            && request.auth.uid == userId
            && incoming().account_status == 'PENDING'
            && (!('profile_status' in incoming()) || incoming().profile_status == 'PENDING')
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'full_name', 'displayName', 'phone', 'profile_photo',
              'requested_portal', 'requested_role', 'profile_status', 'updated_at', 'updatedAt'
            ])
          )
        );
      allow delete: if isFoundationAdmin() || isBootstrappedAdmin();
    }

    // 1b. Granular User Permissions (Read: Self or Foundation Admin; Write: Foundation Admin ONLY)
    match /user_permissions/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isFoundationAdmin() || isBootstrappedAdmin());
      allow list: if isFoundationAdmin() || isBootstrappedAdmin();
      allow create, update: if (isFoundationAdmin() || isBootstrappedAdmin()) && isValidId(userId)
        && isValidUserPermissions(incoming(), userId)
        && incoming().updated_at == request.time;
      allow delete: if isFoundationAdmin() || isBootstrappedAdmin();
    }

    // 1c. Verified Student Guardianships (Parent <-> Student isolation)
    match /student_guardians/{relationshipId} {
      allow get: if isValidId(relationshipId) && (
        isFoundationAdmin()
        || isTeacher()
        || (isParent() && existing().guardian_uid == request.auth.uid && existing().verification_status == 'verified')
      );
      allow list: if isSignedIn() && (
        isFoundationAdmin()
        || isTeacher()
        || (isParent() && resource.data.guardian_uid == request.auth.uid && resource.data.verification_status == 'verified')
      );
      allow create: if isFoundationAdmin() && isValidId(relationshipId)
        && isValidStudentGuardian(incoming())
        && incoming().created_by == request.auth.uid
        && incoming().created_at == request.time
        && incoming().updated_at == request.time;
      allow update: if isFoundationAdmin() && isValidId(relationshipId)
        && isValidStudentGuardian(incoming())
        && incoming().created_by == existing().created_by
        && incoming().created_at == existing().created_at
        && incoming().updated_at == request.time;
      allow delete: if isFoundationAdmin() && isValidId(relationshipId);
    }

    // 1d. Class Assignments & Mirror Teacher Assignments
    match /class_assignments/{assignmentId} {
      allow get: if isValidId(assignmentId) && (
        isFoundationAdmin()
        || isCommitteeAdmin()
        || (isTeacher() && existing().teacher_uid == request.auth.uid && existing().assignment_status == 'active')
      );
      allow list: if isSignedIn() && (
        isFoundationAdmin()
        || isCommitteeAdmin()
        || (isTeacher() && resource.data.teacher_uid == request.auth.uid && resource.data.assignment_status == 'active')
      );
      allow create: if isFoundationAdmin() && isValidId(assignmentId)
        && isValidClassAssignment(incoming())
        && incoming().created_by == request.auth.uid
        && incoming().created_at == request.time
        && incoming().updated_at == request.time;
      allow update: if isFoundationAdmin() && isValidId(assignmentId)
        && isValidClassAssignment(incoming())
        && incoming().created_by == existing().created_by
        && incoming().created_at == existing().created_at
        && incoming().updated_at == request.time;
      allow delete: if isFoundationAdmin() && isValidId(assignmentId);
    }

    match /teacher_assignments/{assignmentId} {
      allow get: if isValidId(assignmentId) && (
        isFoundationAdmin()
        || isCommitteeAdmin()
        || (isTeacher() && existing().teacher_uid == request.auth.uid && existing().assignment_status == 'active')
      );
      allow list: if isSignedIn() && (
        isFoundationAdmin()
        || isCommitteeAdmin()
        || (isTeacher() && resource.data.teacher_uid == request.auth.uid && resource.data.assignment_status == 'active')
      );
      allow create: if isFoundationAdmin() && isValidId(assignmentId)
        && isValidClassAssignment(incoming())
        && incoming().created_by == request.auth.uid
        && incoming().created_at == request.time
        && incoming().updated_at == request.time;
      allow update: if isFoundationAdmin() && isValidId(assignmentId)
        && isValidClassAssignment(incoming())
        && incoming().created_by == existing().created_by
        && incoming().created_at == existing().created_at
        && incoming().updated_at == request.time;
      allow delete: if isFoundationAdmin() && isValidId(assignmentId);
    }

    // 2. System Configuration (Yayasan Only for Write)
    match /systemConfig/{configId} {
      allow get: if isActiveUser() && isValidId(configId);
      allow list: if isActiveUser();
      allow create, update: if isFoundationAdmin() && isValidId(configId)
        && isValidSystemConfig(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isFoundationAdmin() && isValidId(configId);
    }

    // 3. Master Units & Education Units (Yayasan Only for Write; Active Read for Login Catalog)
    match /units/{unitId} {
      allow get: if isValidId(unitId) && (
        (isActiveStaff() && isUnitAuthorizedForKomite(existing().code))
        || existing().status == 'ACTIVE'
      );
      allow list: if isActiveStaff() || resource.data.status == 'ACTIVE';
      allow create: if isFoundationAdmin() && isValidId(unitId)
        && isValidUnit(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isFoundationAdmin() && isValidId(unitId)
        && isValidUnit(incoming())
        && incoming().code == existing().code
        && incoming().updatedAt == request.time;
      allow delete: if isFoundationAdmin() && isValidId(unitId);
    }

    match /education_units/{unitId} {
      allow get: if isValidId(unitId) && (
        (isActiveStaff() && isUnitAuthorizedForKomite(existing().code))
        || existing().status == 'ACTIVE'
      );
      allow list: if isActiveStaff() || resource.data.status == 'ACTIVE';
      allow create: if isFoundationAdmin() && isValidId(unitId)
        && isValidUnit(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isFoundationAdmin() && isValidId(unitId)
        && isValidUnit(incoming())
        && incoming().code == existing().code
        && incoming().updatedAt == request.time;
      allow delete: if isFoundationAdmin() && isValidId(unitId);
    }

    // 3b. Cohorts (Angkatan — Yayasan Write, Active Staff Read)
    match /cohorts/{cohortId} {
      allow get: if isActiveStaff() && isValidId(cohortId);
      allow list: if isActiveStaff();
      allow create: if isFoundationAdmin() && isValidId(cohortId)
        && isValidCohort(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isFoundationAdmin() && isValidId(cohortId)
        && isValidCohort(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isFoundationAdmin() && isValidId(cohortId);
    }

    // 3c. Academic Years & Semesters (Yayasan Write, Active Read + Active-Only Login Catalog Query)
    match /academic_years/{yearId} {
      allow get: if isValidId(yearId) && (isActiveUser() || (existing().isActive == true && existing().status == 'ACTIVE'));
      allow list: if isActiveUser() || (resource.data.isActive == true && resource.data.status == 'ACTIVE');
      allow create: if isFoundationAdmin() && isValidId(yearId)
        && isValidAcademicYear(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isFoundationAdmin() && isValidId(yearId)
        && isValidAcademicYear(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isFoundationAdmin() && isValidId(yearId);
    }

    match /semesters/{semesterId} {
      allow get: if isActiveUser() && isValidId(semesterId);
      allow list: if isActiveUser();
      allow create: if isFoundationAdmin() && isValidId(semesterId)
        && isValidSemester(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isFoundationAdmin() && isValidId(semesterId)
        && isValidSemester(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isFoundationAdmin() && isValidId(semesterId);
    }

    // 4. Academic Periods (Yayasan Only for Write; Active signed-in users can read period names)
    match /academicPeriods/{periodId} {
      allow get: if isActiveUser() && isValidId(periodId);
      allow list: if isActiveUser();
      allow create: if isFoundationAdmin() && isValidId(periodId)
        && isValidPeriod(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isFoundationAdmin() && isValidId(periodId)
        && isValidPeriod(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isFoundationAdmin() && isValidId(periodId);
    }

    // 5. Master Classes (Komite, Student, Parent Blocked from Write; Active-Only Login Catalog Query Allowed)
    match /classes/{classId} {
      allow get: if isValidId(classId) && (isActiveStaff() || isStudent() || isParent() || existing().status == 'ACTIVE');
      allow list: if isActiveStaff() || isStudent() || isParent() || resource.data.status == 'ACTIVE';
      allow create: if isFoundationAdmin() && isValidId(classId)
        && isValidClass(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isFoundationAdmin() && isValidId(classId)
        && isValidClass(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isFoundationAdmin() && isValidId(classId);
    }

    // 5b. Class Student History (Immutable Audit History of Promotion/Placement; Student reads own history only)
    match /class_student_history/{historyId} {
      allow get: if isValidId(historyId) && (isFoundationAdmin() || isTeacher() || isCommitteeAdmin() || (isStudent() && existing().studentUid == request.auth.uid));
      allow list: if isActiveStaff() || (isStudent() && resource.data.studentUid == request.auth.uid);
      allow create: if isFoundationAdmin() && isValidId(historyId)
        && isValidClassStudentHistory(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 6. Master Teachers (Onboarding draft allowed for PENDING own doc; Self personal update; Write by Foundation Admin)
    match /teachers/{teacherId} {
      allow get: if isValidId(teacherId) && (
        isActiveStaff()
        || (isPendingUser() && existing().user_uid == request.auth.uid)
      );
      allow list: if isActiveStaff() || (isPendingUser() && resource.data.user_uid == request.auth.uid);
      allow create: if isValidId(teacherId) && isValidTeacher(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isFoundationAdmin()
          || (
            isPendingUser()
            && incoming().user_uid == request.auth.uid
            && incoming().profile_status == 'PENDING'
            && incoming().status == 'PENDING'
          )
        );
      allow update: if isValidId(teacherId) && isValidTeacher(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isFoundationAdmin()
          || (
            isTeacher()
            && existing().user_uid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'full_name', 'phone', 'address', 'profile_photo', 'updatedAt'])
          )
          || (
            isPendingUser()
            && existing().user_uid == request.auth.uid
            && incoming().profile_status == 'PENDING'
            && incoming().status == 'PENDING'
          )
        );
      allow delete: if isFoundationAdmin() && isValidId(teacherId);
    }

    // 6b. Guardians, Committee Members, Foundation Admins
    match /guardians/{guardianId} {
      allow get: if isValidId(guardianId) && (
        isFoundationAdmin()
        || (isActiveUser() && existing().user_uid == request.auth.uid)
        || (isPendingUser() && existing().user_uid == request.auth.uid)
      );
      allow list: if isFoundationAdmin()
        || (isActiveUser() && resource.data.user_uid == request.auth.uid)
        || (isPendingUser() && resource.data.user_uid == request.auth.uid);
      allow create: if isValidId(guardianId) && isValidGuardian(incoming())
        && incoming().updatedAt == request.time
        && (
          isFoundationAdmin()
          || (
            isPendingUser()
            && incoming().user_uid == request.auth.uid
            && incoming().verification_status == 'pending'
            && incoming().status == 'PENDING'
          )
        );
      allow update: if isValidId(guardianId) && isValidGuardian(incoming())
        && incoming().updatedAt == request.time
        && (
          isFoundationAdmin()
          || (
            isParent()
            && existing().user_uid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['full_name', 'phone', 'address', 'profile_photo', 'updatedAt'])
          )
          || (
            isPendingUser()
            && existing().user_uid == request.auth.uid
            && incoming().verification_status == 'pending'
            && incoming().status == 'PENDING'
          )
        );
      allow delete: if isFoundationAdmin() && isValidId(guardianId);
    }

    match /committee_members/{memberId} {
      allow get: if isValidId(memberId) && (
        isFoundationAdmin()
        || isCommitteeAdmin()
        || (isPendingUser() && existing().user_uid == request.auth.uid)
      );
      allow list: if isFoundationAdmin()
        || isCommitteeAdmin()
        || (isPendingUser() && resource.data.user_uid == request.auth.uid);
      allow create: if isValidId(memberId) && isValidCommitteeMember(incoming())
        && incoming().updatedAt == request.time
        && (
          isFoundationAdmin()
          || (
            isPendingUser()
            && incoming().user_uid == request.auth.uid
            && incoming().profile_status == 'PENDING'
            && incoming().status == 'PENDING'
          )
        );
      allow update: if isValidId(memberId) && isValidCommitteeMember(incoming())
        && incoming().updatedAt == request.time
        && (
          isFoundationAdmin()
          || (
            isCommitteeAdmin()
            && existing().user_uid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['full_name', 'phone', 'profile_photo', 'updatedAt'])
          )
          || (
            isPendingUser()
            && existing().user_uid == request.auth.uid
            && incoming().profile_status == 'PENDING'
            && incoming().status == 'PENDING'
          )
        );
      allow delete: if isFoundationAdmin() && isValidId(memberId);
    }

    match /foundation_admins/{adminId} {
      allow get: if isFoundationAdmin() && isValidId(adminId);
      allow list: if isFoundationAdmin();
      allow create, update: if isFoundationAdmin() && isValidId(adminId)
        && isValidFoundationAdmin(incoming())
        && incoming().updatedAt == request.time;
      allow delete: if isFoundationAdmin() && isValidId(adminId);
    }

    // 7. Individual Students (Strict RBAC: Parent/Student only see verified linked students; Onboarding draft allowed for PENDING own doc; Self personal update; Write ONLY Yayasan/Guru in assigned unit+class)
    match /students/{studentId} {
      allow get: if isValidId(studentId) && (
        isFoundationAdmin()
        || (isTeacher() && isGuruAuthorizedForUnitAndClass(existing().unitCode, existing().classId))
        || hasKomiteStudentAccess()
        || (isStudent() && (existing().studentUid == request.auth.uid || isLinkedToStudent(studentId)))
        || (isParent() && ((('guardianUids' in existing()) && request.auth.uid in existing().guardianUids) || isLinkedToStudent(studentId)))
        || (isPendingUser() && existing().studentUid == request.auth.uid)
      );
      allow list: if (isActiveUser() || isPendingUser()) && (
        isFoundationAdmin()
        || isClassAuthorizedForTeacher(resource.data.classId)
        || hasKomiteStudentAccess()
        || (isStudent() && resource.data.studentUid == request.auth.uid)
        || (isParent() && ('guardianUids' in resource.data) && (request.auth.uid in resource.data.guardianUids))
        || (isPendingUser() && resource.data.studentUid == request.auth.uid)
      );
      allow create: if isValidId(studentId) && isValidStudent(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isFoundationAdmin()
          || (isTeacher() && isGuruAuthorizedForUnitAndClass(incoming().unitCode, incoming().classId))
          || (
            isPendingUser()
            && incoming().studentUid == request.auth.uid
            && incoming().profile_status == 'PENDING'
            && incoming().status == 'PENDING'
          )
        );
      allow update: if isValidId(studentId) && isValidStudent(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isFoundationAdmin()
          || (isTeacher() && isGuruAuthorizedForUnitAndClass(incoming().unitCode, incoming().classId))
          || (
            isStudent()
            && existing().studentUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['phone', 'address', 'profile_photo', 'updatedAt'])
          )
          || (
            isPendingUser()
            && existing().studentUid == request.auth.uid
            && incoming().profile_status == 'PENDING'
            && incoming().status == 'PENDING'
          )
        );
      allow delete: if isFoundationAdmin() && isValidId(studentId);
    }

    // 8. Individual Student Assessments & Excel Import (Historical assessments protected from delete)
    match /studentAssessments/{assessmentId} {
      allow get: if isValidId(assessmentId) && (
        isFoundationAdmin()
        || (isTeacher() && isGuruAuthorizedForUnitAndClass(existing().unitCode, existing().classId))
        || hasKomiteStudentAccess()
        || ((isStudent() || isParent()) && existing().isPublishedToParents == true && isLinkedToStudent(existing().studentId))
      );
      allow list: if isActiveUser() && (
        isFoundationAdmin()
        || isClassAuthorizedForTeacher(resource.data.classId)
        || hasKomiteStudentAccess()
        || ((isStudent() || isParent()) && resource.data.isPublishedToParents == true && isLinkedToStudent(resource.data.studentId))
      );
      allow create: if isValidId(assessmentId)
        && isValidStudentAssessment(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/students/$(incoming().studentId))
        && exists(/databases/$(database)/documents/academicPeriods/$(incoming().periodId))
        && (
          incoming().verificationStatus != 'Terverifikasi'
          || isFoundationAdmin()
          || hasPermission('assessment:verify')
        )
        && (
          isFoundationAdmin()
          || (
            isGuruAuthorizedForUnitAndClass(incoming().unitCode, incoming().classId)
            && get(/databases/$(database)/documents/students/$(incoming().studentId)).data.classId == incoming().classId
            && get(/databases/$(database)/documents/academicPeriods/$(incoming().periodId)).data.isActive == true
          )
        );
      allow update: if isValidId(assessmentId)
        && isValidStudentAssessment(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().studentId == existing().studentId
        && incoming().periodId == existing().periodId
        && isVerifiedAssessmentChangeAllowed()
        && (
          incoming().verificationStatus != 'Terverifikasi'
          || isFoundationAdmin()
          || hasPermission('assessment:verify')
        )
        && (
          isFoundationAdmin()
          || (
            isGuruAuthorizedForUnitAndClass(incoming().unitCode, incoming().classId)
            && get(/databases/$(database)/documents/students/$(incoming().studentId)).data.classId == incoming().classId
            && get(/databases/$(database)/documents/academicPeriods/$(incoming().periodId)).data.isActive == true
          )
        );
      allow delete: if false;
    }

    // 9. Mutabaah Logs (Historical logs protected from delete)
    match /mutabaahLogs/{logId} {
      allow get: if isValidId(logId) && (
        isFoundationAdmin()
        || (isTeacher() && isGuruAuthorizedForUnitAndClass(existing().unitCode, existing().classId))
        || isCommitteeAdmin()
        || ((isStudent() || isParent()) && existing().isPublishedToParents == true && isLinkedToStudent(existing().studentId))
      );
      allow list: if isActiveUser() && (
        isFoundationAdmin()
        || isClassAuthorizedForTeacher(resource.data.classId)
        || isCommitteeAdmin()
        || ((isStudent() || isParent()) && resource.data.isPublishedToParents == true && isLinkedToStudent(resource.data.studentId))
      );
      allow create: if (isFoundationAdmin() || isGuruAuthorizedForUnitAndClass(incoming().unitCode, incoming().classId))
        && isValidId(logId)
        && isValidMutabaahLog(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (isFoundationAdmin() || isGuruAuthorizedForUnitAndClass(incoming().unitCode, incoming().classId))
        && isValidId(logId)
        && isValidMutabaahLog(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 10. Excel Import History (Immutable logs)
    match /excelImportLogs/{logId} {
      allow get: if isValidId(logId) && (isFoundationAdmin() || isCommitteeAdmin() || (isTeacher() && existing().teacherUid == request.auth.uid));
      allow list: if isActiveUser() && (isFoundationAdmin() || isCommitteeAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid));
      allow create: if (isFoundationAdmin() || isTeacher()) && isValidId(logId)
        && isValidExcelImportLog(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 11. Audit Trail (Immutable logs — auditLogs & audit_logs)
    match /auditLogs/{logId} {
      allow get: if isFoundationAdmin() && isValidId(logId);
      allow list: if isFoundationAdmin();
      allow create: if (isFoundationAdmin() || isTeacher() || isCommitteeAdmin()) && isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow get: if isFoundationAdmin() && isValidId(logId);
      allow list: if isFoundationAdmin();
      allow create: if (isFoundationAdmin() || isTeacher() || isCommitteeAdmin()) && isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 12. Unit Aggregates (Komite strictly READ-ONLY)
    match /unitAggregates/{aggregateId} {
      allow get: if isActiveStaff() && isValidId(aggregateId) && isUnitAuthorizedForKomite(existing().unitCode);
      allow list: if isActiveStaff();
      allow create: if (isFoundationAdmin() || isUnitAuthorizedForTeacher(incoming().unitCode)) && isValidId(aggregateId)
        && isValidUnitAggregate(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if (isFoundationAdmin() || (isUnitAuthorizedForTeacher(existing().unitCode) && incoming().unitCode == existing().unitCode)) && isValidId(aggregateId)
        && isValidUnitAggregate(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if isFoundationAdmin() && isValidId(aggregateId);
    }

    // 13. Religious Programs: Monev, Mutabaah, Pembiasaan (Komite can add evaluation note only)
    match /religiousPrograms/{programId} {
      allow get: if isActiveStaff() && isValidId(programId) && isUnitAuthorizedForKomite(existing().unitCode);
      allow list: if isActiveStaff();
      allow create: if (isFoundationAdmin() || isUnitAuthorizedForTeacher(incoming().unitCode)) && isValidId(programId)
        && isValidReligiousProgram(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(programId)
        && isValidReligiousProgram(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isFoundationAdmin()
          || (isUnitAuthorizedForTeacher(existing().unitCode) && incoming().unitCode == existing().unitCode)
          || (isCommitteeAdmin() && isUnitAuthorizedForKomite(existing().unitCode) && incoming().diff(existing()).affectedKeys().hasOnly(['komiteEvaluationNote', 'updatedAt']))
        );
      allow delete: if isFoundationAdmin() && isValidId(programId);
    }

    // 14. Komite Findings & Recommendations
    match /komiteFindings/{findingId} {
      allow get: if isActiveStaff() && isValidId(findingId) && isUnitAuthorizedForKomite(existing().unitCode);
      allow list: if isActiveStaff();
      allow create: if (isCommitteeAdmin() || isFoundationAdmin()) && isValidId(findingId)
        && isValidKomiteFinding(incoming())
        && incoming().followUpStatus == 'Baru'
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(findingId)
        && isValidKomiteFinding(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isCommitteeAdmin() && isUnitAuthorizedForKomite(existing().unitCode))
          || (isFoundationAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['followUpStatus', 'followUpResponse', 'updatedAt']))
          || (
            isTeacher()
            && (existing().unitCode == 'Seluruh Unit' || isUnitAuthorizedForTeacher(existing().unitCode))
            && incoming().diff(existing()).affectedKeys().hasOnly(['followUpStatus', 'followUpResponse', 'updatedAt'])
            && incoming().followUpStatus in ['Diterima', 'Dalam Proses', 'Menunggu Verifikasi']
          )
        );
      allow delete: if (isCommitteeAdmin() || isFoundationAdmin()) && isValidId(findingId);
    }

    // 15. Komite Meetings
    match /komiteMeetings/{meetingId} {
      allow get: if isActiveStaff() && isValidId(meetingId);
      allow list: if isActiveStaff();
      allow create: if (isCommitteeAdmin() || isFoundationAdmin()) && isValidId(meetingId)
        && isValidKomiteMeeting(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (isCommitteeAdmin() || isFoundationAdmin()) && isValidId(meetingId)
        && isValidKomiteMeeting(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if (isCommitteeAdmin() || isFoundationAdmin()) && isValidId(meetingId);
    }

    // 16. Komite Decisions
    match /komiteDecisions/{decisionId} {
      allow get: if isActiveStaff() && isValidId(decisionId) && isUnitAuthorizedForKomite(existing().unitCode);
      allow list: if isActiveStaff();
      allow create: if (isCommitteeAdmin() || isFoundationAdmin()) && isValidId(decisionId)
        && isValidKomiteDecision(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(decisionId)
        && isValidKomiteDecision(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isCommitteeAdmin() && isUnitAuthorizedForKomite(existing().unitCode))
          || isFoundationAdmin()
          || (
            isTeacher()
            && (existing().unitCode == 'Seluruh Unit' || isUnitAuthorizedForTeacher(existing().unitCode))
            && incoming().diff(existing()).affectedKeys().hasOnly(['executionStatus', 'progressNote', 'updatedAt'])
          )
        );
      allow delete: if (isCommitteeAdmin() || isFoundationAdmin()) && isValidId(decisionId);
    }

    // 17. Komite Reports
    match /komiteReports/{reportId} {
      allow get: if (isCommitteeAdmin() || isFoundationAdmin()) && isValidId(reportId);
      allow list: if isCommitteeAdmin() || isFoundationAdmin();
      allow create: if (isCommitteeAdmin() || isFoundationAdmin()) && isValidId(reportId)
        && isValidKomiteReport(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (isCommitteeAdmin() || isFoundationAdmin()) && isValidId(reportId)
        && isValidKomiteReport(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if (isCommitteeAdmin() || isFoundationAdmin()) && isValidId(reportId);
    }
  }
}
